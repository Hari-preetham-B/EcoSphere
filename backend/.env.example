# Flask Server Configuration
SECRET_KEY=ecosphere-secret-key-change-in-production
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database & Supabase Configuration
# PostgreSQL connection string for Supabase database (defaults to sqlite:///ecosphere.db if omitted)
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# Supabase Auth & Storage API Keys
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Brevo (formerly Sendinblue) Email SMTP Credentials (Optional for Email Delivery)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@example.com
BREVO_SMTP_KEY=your_brevo_smtp_key_here
SENDER_EMAIL=noreply@ecosphere.com
